{
  "name": "SourceVerification",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "opportunity_title": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "reachable",
        "unreachable",
        "changed",
        "not_found"
      ],
      "default": "reachable"
    },
    "checked_date": {
      "type": "string"
    },
    "checked_by_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "next_check_date": {
      "type": "string"
    }
  },
  "required": [
    "opportunity_id",
    "outcome"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}