{
  "name": "UserDocument",
  "type": "object",
  "properties": {
    "document_code": {
      "type": "string"
    },
    "document_name": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "missing",
        "uploaded",
        "pending_verification",
        "verified",
        "expired",
        "rejected"
      ],
      "default": "uploaded"
    },
    "issued_date": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "verification_note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "document_code",
    "document_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}