{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "domicile_state": {
      "type": "string"
    },
    "education_level": {
      "type": "string",
      "enum": [
        "class_10",
        "class_12",
        "undergraduate",
        "postgraduate",
        "phd",
        "diploma",
        "iti",
        "none"
      ]
    },
    "course": {
      "type": "string"
    },
    "current_study_year": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "obc",
        "sc",
        "st",
        "ews",
        "minority",
        "other"
      ]
    },
    "gender": {
      "type": "string",
      "enum": [
        "female",
        "male",
        "other",
        "prefer_not_to_say"
      ]
    },
    "annual_family_income": {
      "type": "number"
    },
    "marks_percentage": {
      "type": "number"
    },
    "passing_year": {
      "type": "number"
    },
    "age": {
      "type": "number"
    },
    "disability_status": {
      "type": "boolean"
    },
    "entrance_exam_score": {
      "type": "number"
    },
    "notify_deadlines": {
      "type": "boolean",
      "default": true
    },
    "notify_documents": {
      "type": "boolean",
      "default": true
    },
    "notify_readiness": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}